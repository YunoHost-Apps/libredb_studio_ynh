#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop" --log_path="/var/log/$app/$app.log"

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================

if [ -z "${jwt_secret:-}" ]; then
    jwt_secret=$(ynh_string_random --length=48)
    ynh_app_setting_set --key=jwt_secret --value="$jwt_secret"
fi

# 0.17.0~ynh1 and earlier had no seed_databases question: those installs keep
# working exactly as before.
if [ -z "${seed_databases:-}" ]; then
    seed_databases=0
    ynh_app_setting_set --key=seed_databases --value="$seed_databases"
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# --full_replace: a dropped file would otherwise stay in node_modules.
ynh_setup_source --dest_dir="$install_dir" --full_replace

#=================================================
# CONNECT THIS SERVER'S DATABASES
#=================================================
# On every upgrade: a server installed since the last run is added, a database
# created since is listed, and seed_databases set to 0 removes the accounts.
# `yunohost app upgrade libredb_studio --force` runs it on demand. The
# permission is left as the admin set it; a wider one than admins is reported.

_seed_connections_configure

if [ -n "$seed_config_path" ]; then
    _main_permission_warn_if_wider
fi

#=================================================
# UPDATE THE CONFIGURATION
#=================================================
ynh_script_progression "Updating configuration..."

ynh_config_add --jinja --template="env" --destination="$install_dir/.env"

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Web SQL client for 18 database engines" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --log_path="/var/log/$app/$app.log" --wait_until="LibreDB Studio"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
