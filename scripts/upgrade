#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop" --log_path="systemd"

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
# The signing secret moved into the app settings so that sessions survive an
# upgrade. An install from before that has none; generate one now rather than
# letting the first run write a fresh one into the data directory on every
# upgrade, which would log everybody out each time.

if [ -z "${jwt_secret:-}" ]; then
    jwt_secret=$(ynh_string_random --length=48)
    ynh_app_setting_set --key=jwt_secret --value="$jwt_secret"
fi

#=================================================
# INSTALL DEPENDENCIES
#=================================================
ynh_script_progression "Upgrading dependencies..."

ynh_nodejs_install

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# --full_replace because the payload ships a node_modules tree: a file that an
# older release carried and this one dropped would otherwise stay behind and be
# resolved. The data directory is a separate resource and is not touched here.
ynh_setup_source --dest_dir="$install_dir" --full_replace

chown -R "$app:$app" "$install_dir"

#=================================================
# UPDATE THE CONFIGURATION
#=================================================
ynh_script_progression "Updating configuration..."

ynh_config_add --template="env" --destination="$install_dir/.env"

chown "$app:$app" "$install_dir/.env"
chmod 600 "$install_dir/.env"

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Web SQL client for 16 database engines" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --log_path="/var/log/$app/$app.log" --wait_until="LibreDB Studio"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
