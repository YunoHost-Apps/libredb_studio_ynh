#!/bin/bash

source /usr/share/yunohost/helpers

ynh_print_info "Declaring files to be backed up..."

#=================================================
# BACKUP THE APP MAIN DIR
#=================================================

ynh_backup "$install_dir"

#=================================================
# BACKUP THE DATA DIR
#=================================================
# Not --is_big: it holds every saved connection and the administrator account.

ynh_backup "$data_dir"

#=================================================
# SYSTEM CONFIGURATION
#=================================================

ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"

ynh_backup "/etc/systemd/system/$app.service"

ynh_backup "/etc/logrotate.d/$app"

ynh_backup "/var/log/$app/"

#=================================================
# THE DATABASE ACCOUNTS
#=================================================
# Nothing to declare. The accounts the seed_databases question creates live in
# the database servers, and their names and passwords are app settings, which
# every backup carries. The restore creates them again from those settings and
# rewrites the seed file for the servers of the machine it lands on.

#=================================================
# END OF SCRIPT
#=================================================

ynh_print_info "Backup script completed for $app. (YunoHost will then actually copy those files to the archive)."
