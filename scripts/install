#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# GENERATE THE SIGNING SECRET
#=================================================
# In the settings, so an upgrade or a restore does not end every session. The
# administrator password is left to the server, which prints it once.

jwt_secret=$(ynh_string_random --length=48)
ynh_app_setting_set --key=jwt_secret --value="$jwt_secret"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

#=================================================
# CONNECT THIS SERVER'S DATABASES
#=================================================
# Before the service first starts, so the app is never reachable by more than
# the admins group once the seed file exists.

_seed_connections_configure

if [ "$seed_databases" = "1" ]; then
    if [ -z "$seed_config_path" ]; then
        ynh_die "No running MariaDB or PostgreSQL server was found here, so there is nothing to connect. Install an app that uses one first, or install LibreDB Studio without connecting this server's databases."
    fi
    _main_permission_admins_only
fi

#=================================================
# ADD A CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration..."

ynh_config_add --jinja --template="env" --destination="$install_dir/.env"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Web SQL client for 18 database engines" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --log_path="/var/log/$app/$app.log" --wait_until="LibreDB Studio"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
